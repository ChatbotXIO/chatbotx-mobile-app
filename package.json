{
  "name": "chatbotx-mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.105.3",
    "dayjs": "^1.11.23",
    "expo": "~58.0.25",
    "expo-apple-authentication": "~58.0.2",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "i18next": "^26.7.1",
    "lucide-react-native": "^1.67.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "58.0.24",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lefthook": "^2.2.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "generate:api": "tsx scripts/generate-api-client.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "brand:new": "tsx scripts/create-brand.ts",
    "native:clean": "rm -rf ios android",
    "prebuild:check": "BRAND=chatbotx APP_ENV=development expo prebuild --clean --no-install && pnpm native:clean",
    "build": "pnpm build:ios",
    "build:dev": "pnpm native:clean && eas build --profile development",
    "build:test": "pnpm native:clean && eas build --profile preview",
    "build:ios": "pnpm native:clean && eas build --profile preview-testflight -p ios --auto-submit",
    "build:ios:prod": "pnpm native:clean && eas build --profile production -p ios",
    "build:prod": "pnpm native:clean && eas build --profile production",
    "build:android": "pnpm native:clean && eas build --profile preview -p android",
    "build:android:prod": "pnpm native:clean && eas build --profile production -p android",
    "update:test": "eas update --channel preview --environment preview",
    "update:prod": "eas update --channel production --environment production",
    "submit:prod": "eas submit --profile production"
  },
  "private": true
}
